  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "private": true
}
